<section class="rito-final-cta color-{{ section.settings.color_scheme }}">
  <div class="rito-final-cta__inner">
    <div class="rito-final-cta__panel">
      {% if section.settings.eyebrow != blank %}
        <p class="rito-final-cta__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="rito-final-cta__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="rito-final-cta__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      <div class="rito-final-cta__actions">
        <a class="rito-final-cta__button rito-final-cta__button--primary" href="{{ section.settings.primary_button_link | default: '#' }}">
          {{ section.settings.primary_button_label }}
        </a>
        <a class="rito-final-cta__button rito-final-cta__button--secondary" href="{{ section.settings.secondary_button_link | default: '#' }}">
          {{ section.settings.secondary_button_label }}
        </a>
      </div>

      <div class="rito-final-cta__trust" aria-label="Trust highlights">
        {% for block in section.blocks %}
          <div class="rito-final-cta__trust-item" {{ block.shopify_attributes }}>
            <span class="rito-final-cta__trust-mark" aria-hidden="true"></span>
            <span>{{ block.settings.text }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .rito-final-cta {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background: #f8f3ec;
    padding: 90px 40px;
  }

  .rito-final-cta__inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .rito-final-cta__panel {
    position: relative;
    overflow: hidden;
    padding: 72px 48px;
    border-radius: 40px;
    text-align: center;
    color: #ffffff;
    background: linear-gradient(135deg, #2a1b12 0%, #4b2f1e 100%);
    box-shadow: 0 30px 90px rgba(42, 27, 18, 0.18);
  }

  .rito-final-cta__panel::before,
  .rito-final-cta__panel::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .rito-final-cta__panel::before {
    top: -90px;
    right: 50%;
    width: 360px;
    height: 360px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(184, 135, 70, 0.28) 0%, rgba(184, 135, 70, 0) 72%);
    transform: translateX(50%);
  }

  .rito-final-cta__panel::after {
    left: 50%;
    bottom: -120px;
    width: 520px;
    height: 220px;
    opacity: 0.08;
    background:
      radial-gradient(circle at 20% 40%, rgba(255,255,255,0.8) 0 4%, transparent 5% 100%),
      radial-gradient(circle at 48% 68%, rgba(255,255,255,0.8) 0 4%, transparent 5% 100%),
      radial-gradient(circle at 76% 34%, rgba(255,255,255,0.8) 0 4%, transparent 5% 100%);
    transform: translateX(-50%);
  }

  .rito-final-cta__eyebrow,
  .rito-final-cta__heading,
  .rito-final-cta__subheading,
  .rito-final-cta__actions,
  .rito-final-cta__trust {
    position: relative;
    z-index: 1;
  }

  .rito-final-cta__eyebrow {
    margin: 0 0 14px;
    color: #d9b67d;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .rito-final-cta__heading {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading--family);
    font-size: clamp(38px, 5vw, 68px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .rito-final-cta__subheading {
    margin: 18px auto 0;
    max-width: 680px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 18px;
    line-height: 1.7;
  }

  .rito-final-cta__actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 34px;
    flex-wrap: wrap;
  }

  .rito-final-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 220px;
    padding: 16px 28px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background-color 0.28s ease,
      border-color 0.28s ease,
      transform 0.28s ease;
  }

  .rito-final-cta__button--primary {
    background: #b88746;
    color: #ffffff;
  }

  .rito-final-cta__button--primary:hover,
  .rito-final-cta__button--primary:focus-visible {
    background: #9a6a43;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .rito-final-cta__button--secondary {
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: transparent;
    color: #ffffff;
  }

  .rito-final-cta__button--secondary:hover,
  .rito-final-cta__button--secondary:focus-visible {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .rito-final-cta__trust {
    display: flex;
    justify-content: center;
    gap: 18px 24px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  .rito-final-cta__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff7ed;
    font-size: 14px;
    line-height: 1.6;
  }

  .rito-final-cta__trust-mark {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(135deg, #e1c07f 0%, #b88746 100%);
    box-shadow: 0 0 0 5px rgba(184, 135, 70, 0.12);
  }

  @media screen and (max-width: 749px) {
    .rito-final-cta {
      padding: 64px 18px;
    }

    .rito-final-cta__panel {
      padding: 48px 22px;
    }

    .rito-final-cta__heading {
      font-size: 36px;
    }

    .rito-final-cta__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .rito-final-cta__button {
      width: 100%;
      min-width: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rito Final CTA",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 3,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOP RITO DEL CAFFE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready for Your Perfect Cup?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Paragraph",
      "default": "Bring home the rich aroma, smooth taste, and Italian-inspired ritual of Rito Del Caffe 1937."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop All Coffee"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Explore Sampler Pack"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Premium Italian-inspired blends"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rito Final CTA",
      "blocks": [
        {
          "type": "trust",
          "settings": {
            "text": "Premium Italian-inspired blends"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Fresh aroma"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Smooth everyday coffee"
          }
        }
      ]
    }
  ]
}
{% endschema %}
