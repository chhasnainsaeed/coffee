<section class="rito-brand-story color-{{ section.settings.color_scheme }}">
  <div class="rito-brand-story__inner">
    <div class="rito-brand-story__media-panel">
      <div class="rito-brand-story__media-shell">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              class: 'rito-brand-story__image',
              widths: '720, 960, 1200, 1440, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: section.settings.image.alt | default: section.settings.heading,
              loading: 'lazy'
          }}
        {% else %}
          <div class="rito-brand-story__placeholder" aria-hidden="true">
            <svg class="rito-brand-story__placeholder-art" viewBox="0 0 820 760" fill="none">
              <ellipse cx="222" cy="650" rx="150" ry="50" fill="rgba(42,27,18,0.12)"/>
              <ellipse cx="516" cy="682" rx="116" ry="34" fill="rgba(42,27,18,0.10)"/>
              <rect x="222" y="146" width="286" height="400" rx="42" fill="#E3CBAF"/>
              <path d="M262 212c22-40 72-64 102-64 48 0 94 22 126 64" stroke="#8B5E3C" stroke-width="14" stroke-linecap="round"/>
              <path d="M294 276h144" stroke="#B88746" stroke-width="14" stroke-linecap="round"/>
              <path d="M304 338c34 18 116 18 150 0" stroke="#8B5E3C" stroke-width="10" stroke-linecap="round"/>
              <path d="M368 244c-42 14-68 58-68 112 0 64 32 114 68 114s68-50 68-114c0-54-28-98-68-112Z" fill="#704526"/>
              <path d="M368 270c20 30 22 112 0 170" stroke="#EADBC7" stroke-width="8" stroke-linecap="round"/>
              <ellipse cx="164" cy="614" rx="64" ry="36" fill="#8B5E3C"/>
              <path d="M164 594c14 16 14 26 0 40" stroke="#F6EBDD" stroke-width="7" stroke-linecap="round"/>
              <ellipse cx="536" cy="618" rx="58" ry="32" fill="#9A6A43"/>
              <path d="M536 600c12 14 12 22 0 36" stroke="#F6EBDD" stroke-width="6" stroke-linecap="round"/>
              <ellipse cx="630" cy="646" rx="36" ry="20" fill="#7C5430"/>
              <path d="M630 634c8 10 8 16 0 24" stroke="#F6EBDD" stroke-width="4.5" stroke-linecap="round"/>
              <rect x="466" y="164" width="184" height="104" rx="28" fill="#FAF2E8" stroke="#D7B993" stroke-width="6"/>
              <path d="M500 216h88c28 0 50 22 50 50v8" stroke="#8B5E3C" stroke-width="8" stroke-linecap="round"/>
              <path d="M498 214c10-34 32-56 54-56 20 0 44 22 56 56" fill="#704526"/>
              <path d="M498 214c10-34 32-56 54-56 20 0 44 22 56 56" stroke="#704526" stroke-width="8"/>
              <path d="M524 142c-8-16 10-30 5-46" stroke="#B88746" stroke-width="6" stroke-linecap="round"/>
              <path d="M566 136c-8-16 10-30 5-46" stroke="#B88746" stroke-width="6" stroke-linecap="round"/>
              <path d="M608 142c-8-16 10-30 5-46" stroke="#B88746" stroke-width="6" stroke-linecap="round"/>
            </svg>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="rito-brand-story__content">
      {% if section.settings.eyebrow != blank %}
        <p class="rito-brand-story__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="rito-brand-story__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="rito-brand-story__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.body_text != blank %}
        <p class="rito-brand-story__body">{{ section.settings.body_text }}</p>
      {% endif %}

      <div class="rito-brand-story__features">
        {% for block in section.blocks %}
          <article class="rito-brand-story__feature" {{ block.shopify_attributes }}>
            <div class="rito-brand-story__feature-mark" aria-hidden="true"></div>
            <div>
              <h3 class="rito-brand-story__feature-title">{{ block.settings.title }}</h3>
              <p class="rito-brand-story__feature-text">{{ block.settings.text }}</p>
            </div>
          </article>
        {% endfor %}
      </div>

      <a class="rito-brand-story__button" href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label }}
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .rito-brand-story {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background: #f8f3ec;
    padding: 100px 40px;
  }

  .rito-brand-story__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .rito-brand-story__media-shell {
    position: relative;
    overflow: hidden;
    min-height: 640px;
    border-radius: 34px;
    background:
      radial-gradient(circle at 24% 16%, rgba(255, 249, 240, 0.9), rgba(255, 249, 240, 0) 34%),
      linear-gradient(180deg, #f4eadf 0%, #e7d3bc 100%);
    box-shadow: 0 24px 70px rgba(42, 27, 18, 0.1);
  }

  .rito-brand-story__media-shell::after {
    content: '';
    position: absolute;
    inset: auto auto 26px 26px;
    width: 150px;
    height: 150px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(184, 135, 70, 0.22) 0%, rgba(184, 135, 70, 0) 72%);
    pointer-events: none;
  }

  .rito-brand-story__image,
  .rito-brand-story__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 640px;
  }

  .rito-brand-story__image {
    object-fit: cover;
  }

  .rito-brand-story__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 34px;
  }

  .rito-brand-story__placeholder-art {
    width: 100%;
    height: 100%;
    color: rgba(122, 77, 42, 0.92);
  }

  .rito-brand-story__content {
    max-width: 620px;
  }

  .rito-brand-story__eyebrow {
    margin: 0 0 12px;
    color: #9a6a43;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .rito-brand-story__heading {
    margin: 0;
    color: #20140e;
    font-family: var(--font-heading--family);
    font-size: clamp(38px, 4.6vw, 62px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .rito-brand-story__subheading {
    margin: 18px 0 0;
    color: #7a6a5c;
    font-size: 18px;
    line-height: 1.7;
  }

  .rito-brand-story__body {
    margin: 24px 0 0;
    color: #3c2b21;
    font-size: 17px;
    line-height: 1.8;
  }

  .rito-brand-story__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 22px;
    margin-top: 34px;
  }

  .rito-brand-story__feature {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 14px;
    padding: 18px 18px 18px 16px;
    border: 1px solid rgba(232, 222, 210, 0.95);
    border-radius: 20px;
    background: #fffdf9;
    box-shadow: 0 14px 34px rgba(42, 27, 18, 0.05);
  }

  .rito-brand-story__feature-mark {
    width: 18px;
    height: 18px;
    margin-top: 4px;
    border-radius: 999px;
    background: linear-gradient(135deg, #dfc087 0%, #b88746 100%);
    box-shadow: 0 0 0 6px rgba(184, 135, 70, 0.12);
  }

  .rito-brand-story__feature-title {
    margin: 0;
    color: #20140e;
    font-family: var(--font-heading--family);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
  }

  .rito-brand-story__feature-text {
    margin: 8px 0 0;
    color: #7a6a5c;
    font-size: 14px;
    line-height: 1.7;
  }

  .rito-brand-story__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 218px;
    margin-top: 34px;
    padding: 15px 28px;
    border-radius: 999px;
    background: #2a1b12;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.28s ease,
      transform 0.28s ease;
  }

  .rito-brand-story__button:hover,
  .rito-brand-story__button:focus-visible {
    background: #b88746;
    color: #ffffff;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 1099px) {
    .rito-brand-story__inner {
      grid-template-columns: 1fr;
    }

    .rito-brand-story__content {
      max-width: none;
    }
  }

  @media screen and (max-width: 749px) {
    .rito-brand-story {
      padding: 64px 18px;
    }

    .rito-brand-story__media-shell,
    .rito-brand-story__image,
    .rito-brand-story__placeholder {
      min-height: 420px;
    }

    .rito-brand-story__features {
      grid-template-columns: 1fr;
    }

    .rito-brand-story__heading {
      font-size: 38px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rito Brand Story",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Quality promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Rito Del Caffe 1937?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Inspired by Italian coffee tradition, crafted for rich aroma, smooth taste, and everyday rituals."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Paragraph",
      "default": "Every blend is created to bring the richness of Italian coffee culture into your daily ritual - from bold espresso moments to smooth, comforting cups."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Our Coffee"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Italian Inspired Blends"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Crafted for authentic espresso, cappuccino, and smooth daily coffee rituals."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rito Brand Story",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Italian Inspired Blends",
            "text": "Crafted for authentic espresso, cappuccino, and smooth daily coffee rituals."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Premium Roast Profiles",
            "text": "Balanced roast levels designed for aroma, body, and rich crema."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Freshly Selected Coffee",
            "text": "Carefully selected blends for consistent taste and quality."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Made for Every Ritual",
            "text": "From bold espresso to smooth filter coffee and sampler packs."
          }
        }
      ]
    }
  ]
}
{% endschema %}
