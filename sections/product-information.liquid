{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign primary_media = current_variant.featured_media | default: product.featured_media | default: product.media.first

  assign subtitle = product.metafields.custom.subtitle.value | default: product.metafields.custom.subtitle
  assign roast_level = product.metafields.custom.roast_level.value | default: product.metafields.custom.roast_level
  assign coffee_type = product.metafields.custom.coffee_type.value | default: product.metafields.custom.coffee_type
  assign net_weight = product.metafields.custom.net_weight.value | default: product.metafields.custom.net_weight

  case product.handle
    when 'il-cappuccino'
      assign fallback_subtitle = 'Rich & Creamy Italian Blend'
      assign fallback_roast = 'Medium Roast'
      assign fallback_type = 'Premium Whole Bean Coffee'
      assign fallback_weight = '250g / 8.8oz'
      assign brew_methods = 'espresso,cappuccino'
    when 'il-decaf'
      assign fallback_subtitle = 'Smooth Italian Decaffeinated Blend'
      assign fallback_roast = 'Medium Roast'
      assign fallback_type = 'Premium Whole Bean Coffee'
      assign fallback_weight = '250g / 8.8oz'
      assign brew_methods = 'cappuccino,filter'
    when 'lespresso', 'l-espresso', 'the-espresso', 'espresso'
      assign fallback_subtitle = 'Bold & Intense Italian Blend'
      assign fallback_roast = 'Dark Roast'
      assign fallback_type = 'Premium Whole Bean Coffee'
      assign fallback_weight = '250g / 8.8oz'
      assign brew_methods = 'espresso,cappuccino'
    when 'espresso-quattro', 'the-espresso-4'
      assign fallback_subtitle = 'Strong Italian Espresso Blend'
      assign fallback_roast = 'Extra Dark Roast'
      assign fallback_type = 'Premium Whole Bean Coffee'
      assign fallback_weight = '250g / 8.8oz'
      assign brew_methods = 'espresso,cappuccino'
    when 'il-filtro', 'the-filter'
      assign fallback_subtitle = 'Smooth Filter Coffee Blend'
      assign fallback_roast = 'Medium Roast'
      assign fallback_type = 'Premium Whole Bean Coffee'
      assign fallback_weight = '250g / 8.8oz'
      assign brew_methods = 'filter'
    when 'il-maestro', 'the-maestro'
      assign fallback_subtitle = 'Signature Italian House Blend'
      assign fallback_roast = 'Medium-Dark Roast'
      assign fallback_type = 'Premium Whole Bean Coffee'
      assign fallback_weight = '250g / 8.8oz'
      assign brew_methods = 'espresso,cappuccino,filter'
    when 'single-filter', 'the-single-filter'
      assign fallback_subtitle = 'Clean & Balanced Single Serve Filter Coffee'
      assign fallback_roast = 'Medium Roast'
      assign fallback_type = 'Premium Filter Coffee'
      assign fallback_weight = '250g / 8.8oz'
      assign brew_methods = 'filter'
    when 'il-sultano', 'the-sultan'
      assign fallback_subtitle = 'Rich Turkish Style Coffee'
      assign fallback_roast = 'Dark Roast'
      assign fallback_type = 'Premium Ground Coffee'
      assign fallback_weight = '100g / 3.5oz'
      assign brew_methods = 'turkish'
    when 'italian-coffee-sampler', 'sampler-product'
      assign fallback_subtitle = 'A Curated Selection of Premium Italian Blends'
      assign fallback_roast = 'Mixed Roast Selection'
      assign fallback_type = 'Premium Coffee Collection'
      assign fallback_weight = 'Sampler Pack'
      assign brew_methods = 'espresso,cappuccino,filter,turkish'
    else
      assign fallback_subtitle = 'Crafted for rich aroma, smooth taste, and an authentic Italian-inspired coffee ritual.'
      assign fallback_roast = 'Medium Roast'
      assign fallback_type = 'Premium Whole Bean Coffee'
      assign fallback_weight = '250g / 8.8oz'
      assign brew_methods = 'espresso,filter'
  endcase

  if subtitle == blank
    assign subtitle = fallback_subtitle
  endif
  if roast_level == blank
    assign roast_level = fallback_roast
  endif
  if coffee_type == blank
    assign coffee_type = fallback_type
  endif
  if net_weight == blank
    assign net_weight = fallback_weight
  endif

  assign short_description = product.description | strip_html | strip
  if short_description == blank
    assign short_description = 'Crafted for rich aroma, smooth taste, and an authentic Italian-inspired coffee ritual.'
  endif

  assign about_text = product.description | strip_html | strip
  if about_text == blank
    assign about_text = 'Designed for coffee lovers who enjoy a refined daily ritual, this blend delivers balanced aroma, smooth body, and a premium Italian-inspired coffee experience.'
  endif
%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

<section class="rito-product-page color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="rito-product-page__inner">
    <div class="rito-product-page__hero">
      <div class="rito-product-page__gallery">
        <div class="rito-product-page__gallery-card">
          <div class="rito-product-page__gallery-image-wrap">
            {% if primary_media != blank %}
              {{
                primary_media.preview_image
                | image_url: width: 1800
                | image_tag:
                  id: 'RitoMainProductImage-' | append: section.id,
                  class: 'rito-product-page__gallery-image',
                  widths: '720, 960, 1200, 1440, 1800',
                  sizes: '(min-width: 1024px) 50vw, 100vw',
                  alt: primary_media.alt | default: product.title,
                  loading: 'eager'
              }}
            {% else %}
              <div class="rito-product-page__gallery-placeholder" aria-hidden="true">
                <svg class="rito-product-page__gallery-placeholder-art" viewBox="0 0 420 420" role="presentation">
                  <defs>
                    <linearGradient id="rito-coffee-placeholder-bg" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#f6ede2"/>
                      <stop offset="100%" stop-color="#ead8c0"/>
                    </linearGradient>
                  </defs>
                  <rect x="0" y="0" width="420" height="420" rx="36" fill="url(#rito-coffee-placeholder-bg)"/>
                  <ellipse cx="210" cy="316" rx="112" ry="28" fill="#d8bea0"/>
                  <path d="M146 118c0-16 12-28 28-28h71c16 0 28 12 28 28v177c0 20-16 36-36 36h-55c-20 0-36-16-36-36V118z" fill="#8b5e3c"/>
                  <path d="M163 128h94v150c0 18-14 32-32 32h-30c-18 0-32-14-32-32V128z" fill="#bb8d5c"/>
                  <rect x="177" y="171" width="66" height="82" rx="9" fill="#f7f0e5"/>
                  <circle cx="210" cy="145" r="10" fill="#c69b57"/>
                  <path d="M177 93h66l12 32H165l12-32z" fill="#6f482d"/>
                  <path d="M126 320c31 23 50 26 84 26 32 0 56-4 88-26" fill="none" stroke="#5d3d27" stroke-width="10" stroke-linecap="round"/>
                </svg>
              </div>
            {% endif %}
          </div>
        </div>

        {% if product.media.size > 1 %}
          <div class="rito-product-page__thumbnails" aria-label="Product gallery thumbnails">
            {% for media in product.media limit: 4 %}
              <button
                type="button"
                class="rito-product-page__thumb{% if media.id == primary_media.id %} is-active{% endif %}"
                data-media-button
                data-media-src="{{ media.preview_image | image_url: width: 1800 }}"
                data-media-alt="{{ media.alt | default: product.title | escape }}"
                aria-label="View image {{ forloop.index }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 240
                  | image_tag:
                    class: 'rito-product-page__thumb-image',
                    widths: '120, 180, 240',
                    sizes: '96px',
                    alt: media.alt | default: product.title,
                    loading: 'lazy'
                }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="rito-product-page__panel">
        <div class="rito-product-page__purchase-card">
          <p class="rito-product-page__badge">Italian Inspired Coffee</p>
          <h1 class="rito-product-page__title">{{ product.title }}</h1>
          <p class="rito-product-page__subtitle">{{ subtitle }}</p>

          <div class="rito-product-page__rating" aria-label="Rated 4.9 out of 5">
            <span class="rito-product-page__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="rito-product-page__rating-text">4.9 &bull; Customer favourite</span>
          </div>

          <p class="rito-product-page__price">{{ current_variant.price | money }}</p>

          <div class="rito-product-page__meta-grid">
            <div class="rito-product-page__meta-card">
              <span class="rito-product-page__meta-label">Roast</span>
              <span class="rito-product-page__meta-value">{{ roast_level }}</span>
            </div>
            <div class="rito-product-page__meta-card">
              <span class="rito-product-page__meta-label">Coffee Type</span>
              <span class="rito-product-page__meta-value">{{ coffee_type }}</span>
            </div>
            <div class="rito-product-page__meta-card">
              <span class="rito-product-page__meta-label">Net Weight</span>
              <span class="rito-product-page__meta-value">{{ net_weight }}</span>
            </div>
          </div>

          <p class="rito-product-page__short-description">{{ short_description }}</p>

          {% form 'product', product, class: 'rito-product-page__form', id: 'RitoProductForm-' | append: section.id %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">

            <div class="rito-product-page__quantity-row">
              <span class="rito-product-page__quantity-label">Quantity</span>
              <div class="rito-product-page__quantity-control">
                <button type="button" class="rito-product-page__qty-button" data-qty-adjust="-1" aria-label="Decrease quantity">-</button>
                <input
                  class="rito-product-page__qty-input"
                  type="number"
                  name="quantity"
                  min="1"
                  value="{{ current_variant.quantity_rule.min | default: 1 }}"
                  data-qty-input
                  aria-label="Quantity"
                >
                <button type="button" class="rito-product-page__qty-button" data-qty-adjust="1" aria-label="Increase quantity">+</button>
              </div>
            </div>

            <button type="submit" class="rito-product-page__button rito-product-page__button--primary">
              Add to Cart
            </button>

            <a class="rito-product-page__button rito-product-page__button--secondary" href="/cart/{{ current_variant.id }}:1">
              Buy Now
            </a>
          {% endform %}

          <div class="rito-product-page__trust" aria-label="Purchase reassurance">
            <div class="rito-product-page__trust-item"><span class="rito-product-page__trust-mark" aria-hidden="true"></span><span>Secure checkout</span></div>
            <div class="rito-product-page__trust-item"><span class="rito-product-page__trust-mark" aria-hidden="true"></span><span>Fresh aroma</span></div>
            <div class="rito-product-page__trust-item"><span class="rito-product-page__trust-mark" aria-hidden="true"></span><span>Premium Italian-inspired blends</span></div>
          </div>

          <div class="rito-product-page__accordions">
            <details class="rito-product-page__accordion" open>
              <summary>Product Details</summary>
              <div class="rito-product-page__accordion-content">Premium coffee crafted for everyday rituals. Store in a cool, dry place and seal after opening.</div>
            </details>
            <details class="rito-product-page__accordion">
              <summary>Shipping &amp; Returns</summary>
              <div class="rito-product-page__accordion-content">Orders are carefully packed and shipped securely. See our shipping and return policy for details.</div>
            </details>
            <details class="rito-product-page__accordion">
              <summary>Storage Tips</summary>
              <div class="rito-product-page__accordion-content">Keep coffee away from heat, moisture, and direct sunlight to preserve aroma and flavour.</div>
            </details>
          </div>
        </div>
      </div>
    </div>

    <div class="rito-product-page__sections">
      <section class="rito-product-page__info-section">
        <h2 class="rito-product-page__section-title">About This Blend</h2>
        <p class="rito-product-page__section-text">{{ about_text }}</p>
      </section>

      <section class="rito-product-page__info-section">
        <h2 class="rito-product-page__section-title">Tasting Notes</h2>
        <div class="rito-product-page__notes-grid">
          <div class="rito-product-page__note-card">
            <span class="rito-product-page__note-label">Aroma</span>
            <span class="rito-product-page__note-value">Rich &amp; inviting</span>
          </div>
          <div class="rito-product-page__note-card">
            <span class="rito-product-page__note-label">Body</span>
            <span class="rito-product-page__note-value">Smooth and balanced</span>
          </div>
          <div class="rito-product-page__note-card">
            <span class="rito-product-page__note-label">Finish</span>
            <span class="rito-product-page__note-value">Clean and satisfying</span>
          </div>
        </div>
      </section>

      <section class="rito-product-page__info-section">
        <h2 class="rito-product-page__section-title">Best Brewed For</h2>
        <div class="rito-product-page__brew-grid">
          {% if brew_methods contains 'espresso' %}
            <div class="rito-product-page__brew-card">
              <span class="rito-product-page__brew-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="presentation">
                  <path d="M5 9h10a0 0 0 0 1 0 0v3.5A4.5 4.5 0 0 1 10.5 17h-1A4.5 4.5 0 0 1 5 12.5V9a0 0 0 0 1 0 0z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M15 10h2.2a2.3 2.3 0 0 1 0 4.6H15" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M7 19h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
              <span>Espresso</span>
            </div>
          {% endif %}
          {% if brew_methods contains 'cappuccino' %}
            <div class="rito-product-page__brew-card">
              <span class="rito-product-page__brew-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="presentation">
                  <path d="M4.5 11h10v2.8A4.2 4.2 0 0 1 10.3 18H8.7A4.2 4.2 0 0 1 4.5 13.8V11z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M14.5 12h1.9a2.1 2.1 0 0 1 0 4.2h-1.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M6.5 9.2c.6-.8 1.3-1.2 2.1-1.2.7 0 1.3.4 1.8 1 .5-.7 1.1-1 1.7-1 .8 0 1.5.4 2.1 1.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
              <span>Cappuccino</span>
            </div>
          {% endif %}
          {% if brew_methods contains 'filter' %}
            <div class="rito-product-page__brew-card">
              <span class="rito-product-page__brew-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="presentation">
                  <path d="M7 5h10l-3.6 6.6v4.2l-2.8 3.2-2.8-3.2v-4.2L7 5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M8.8 8.8h6.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
              <span>Filter Coffee</span>
            </div>
          {% endif %}
          {% if brew_methods contains 'turkish' %}
            <div class="rito-product-page__brew-card">
              <span class="rito-product-page__brew-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="presentation">
                  <path d="M6 11h8.5l1.5 5H7.5L6 11z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M14.5 11c2.8 0 4.5-1 4.5-3.2 0-1.3-.8-2.1-2.1-2.1-1.1 0-1.8.5-2.4 1.3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M7.5 18.5h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
              <span>Turkish Style</span>
            </div>
          {% endif %}
        </div>
      </section>

      <section class="rito-product-page__info-section">
        <h2 class="rito-product-page__section-title">You May Also Like</h2>
        <div class="rito-product-page__related-grid">
          {% assign related_count = 0 %}
          {% for related_product in collections.all.products %}
            {% if related_product.id != product.id and related_count < 4 %}
              {% assign related_image = related_product.featured_media.preview_image %}
              <article class="rito-product-page__related-card">
                <a href="{{ related_product.url }}" class="rito-product-page__related-link">
                  <div class="rito-product-page__related-media">
                    {% if related_image != blank %}
                      {{
                        related_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'rito-product-page__related-image',
                          widths: '320, 480, 640, 900',
                          sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw',
                          alt: related_image.alt | default: related_product.title,
                          loading: 'lazy'
                      }}
                    {% endif %}
                  </div>
                  <div class="rito-product-page__related-content">
                    <h3 class="rito-product-page__related-title">{{ related_product.title }}</h3>
                    <p class="rito-product-page__related-price">{{ related_product.price | money }}</p>
                  </div>
                </a>
              </article>
              {% assign related_count = related_count | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.rito-product-page').forEach(function (section) {
      section.querySelectorAll('[data-qty-adjust]').forEach(function (button) {
        button.addEventListener('click', function () {
          var input = button.parentElement.querySelector('[data-qty-input]');
          var current = parseInt(input.value || '1', 10);
          var delta = parseInt(button.getAttribute('data-qty-adjust'), 10);
          var next = current + delta;
          input.value = Math.max(1, next);
        });
      });

      section.querySelectorAll('[data-media-button]').forEach(function (button) {
        button.addEventListener('click', function () {
          var mainImage = section.querySelector('.rito-product-page__gallery-image');
          if (!mainImage) return;
          mainImage.src = button.getAttribute('data-media-src');
          mainImage.srcset = '';
          mainImage.alt = button.getAttribute('data-media-alt');

          section.querySelectorAll('[data-media-button]').forEach(function (thumb) {
            thumb.classList.remove('is-active');
          });
          button.classList.add('is-active');
        });
      });
    });
  });
</script>

{% stylesheet %}
  .rito-product-page {
    background: #f8f3ec;
    padding: 80px 40px;
    color: #20140e;
  }

  .rito-product-page__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .rito-product-page__hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: start;
  }

  .rito-product-page__gallery-card {
    min-height: 650px;
    padding: 40px;
    border: 1px solid #e8ded2;
    border-radius: 36px;
    background: linear-gradient(180deg, #f7efe5 0%, #efe1d1 100%);
    box-shadow: 0 28px 80px rgba(42, 27, 18, 0.1);
  }

  .rito-product-page__gallery-image-wrap,
  .rito-product-page__gallery-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 560px;
    height: 100%;
  }

  .rito-product-page__gallery-image,
  .rito-product-page__gallery-placeholder-art {
    width: 100%;
    height: 100%;
    max-height: 560px;
    object-fit: contain;
  }

  .rito-product-page__thumbnails {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 18px;
  }

  .rito-product-page__thumb {
    padding: 10px;
    border: 1px solid #e8ded2;
    border-radius: 20px;
    background: #f8f3ec;
    cursor: pointer;
    transition: border-color 0.28s ease, box-shadow 0.28s ease, transform 0.28s ease;
  }

  .rito-product-page__thumb:hover,
  .rito-product-page__thumb:focus-visible {
    border-color: #b88746;
    transform: translateY(-2px);
  }

  .rito-product-page__thumb.is-active {
    border-color: #b88746;
    box-shadow: 0 0 0 2px rgba(184, 135, 70, 0.14);
  }

  .rito-product-page__thumb-image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .rito-product-page__purchase-card {
    position: sticky;
    top: 24px;
    padding: 42px;
    border: 1px solid #e8ded2;
    border-radius: 36px;
    background: #ffffff;
    box-shadow: 0 28px 80px rgba(42, 27, 18, 0.08);
  }

  .rito-product-page__badge {
    display: inline-flex;
    margin: 0 0 18px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(184, 135, 70, 0.12);
    color: #9a6a43;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .rito-product-page__title {
    margin: 0 0 16px;
    color: #20140e;
    font-family: var(--font-heading--family);
    font-size: clamp(36px, 4vw, 58px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .rito-product-page__subtitle {
    margin: 0;
    color: #7a6a5c;
    font-size: 18px;
    line-height: 1.7;
  }

  .rito-product-page__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
  }

  .rito-product-page__stars {
    color: #b88746;
    letter-spacing: 0.14em;
  }

  .rito-product-page__rating-text {
    color: #7a6a5c;
    font-size: 14px;
  }

  .rito-product-page__price {
    margin: 24px 0;
    color: #9a6a43;
    font-size: 30px;
    font-weight: 800;
  }

  .rito-product-page__meta-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .rito-product-page__meta-card {
    padding: 16px;
    border: 1px solid #e8ded2;
    border-radius: 18px;
    background: #f8f3ec;
  }

  .rito-product-page__meta-label,
  .rito-product-page__note-label {
    display: block;
    margin-bottom: 8px;
    color: #7a6a5c;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .rito-product-page__meta-value,
  .rito-product-page__note-value {
    color: #20140e;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.5;
  }

  .rito-product-page__short-description {
    margin: 24px 0 0;
    color: #4b392d;
    font-size: 16px;
    line-height: 1.75;
  }

  .rito-product-page__form {
    display: grid;
    gap: 14px;
    margin-top: 28px;
  }

  .rito-product-page__quantity-row {
    display: grid;
    gap: 10px;
  }

  .rito-product-page__quantity-label {
    color: #20140e;
    font-size: 14px;
    font-weight: 700;
  }

  .rito-product-page__quantity-control {
    display: inline-grid;
    grid-template-columns: 48px 84px 48px;
    align-items: center;
    overflow: hidden;
    border: 1px solid #e8ded2;
    border-radius: 999px;
    background: #fdfaf6;
  }

  .rito-product-page__qty-button,
  .rito-product-page__qty-input {
    height: 48px;
    border: 0;
    background: transparent;
    color: #20140e;
    text-align: center;
    font-size: 18px;
  }

  .rito-product-page__qty-button {
    cursor: pointer;
  }

  .rito-product-page__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 56px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    transition: background-color 0.28s ease, color 0.28s ease, border-color 0.28s ease, transform 0.28s ease;
  }

  .rito-product-page__button--primary {
    border: 0;
    background: #2a1b12;
    color: #ffffff;
    cursor: pointer;
  }

  .rito-product-page__button--primary:hover,
  .rito-product-page__button--primary:focus-visible {
    background: #b88746;
  }

  .rito-product-page__button--secondary {
    border: 1px solid #2a1b12;
    background: transparent;
    color: #2a1b12;
  }

  .rito-product-page__button--secondary:hover,
  .rito-product-page__button--secondary:focus-visible {
    background: #2a1b12;
    color: #ffffff;
  }

  .rito-product-page__trust {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }

  .rito-product-page__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #7a6a5c;
    font-size: 14px;
  }

  .rito-product-page__trust-mark {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #b88746;
    flex: 0 0 10px;
  }

  .rito-product-page__accordions {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }

  .rito-product-page__accordion {
    overflow: hidden;
    border: 1px solid #e8ded2;
    border-radius: 18px;
    background: #fdfaf6;
  }

  .rito-product-page__accordion summary {
    padding: 18px 18px 16px;
    cursor: pointer;
    font-weight: 700;
    list-style: none;
  }

  .rito-product-page__accordion summary::-webkit-details-marker {
    display: none;
  }

  .rito-product-page__accordion-content {
    padding: 0 18px 18px;
    color: #7a6a5c;
    line-height: 1.7;
  }

  .rito-product-page__sections {
    display: grid;
    gap: 34px;
    margin-top: 48px;
  }

  .rito-product-page__info-section {
    padding: 34px;
    border: 1px solid #e8ded2;
    border-radius: 32px;
    background: #fffdf9;
    box-shadow: 0 16px 42px rgba(42, 27, 18, 0.05);
  }

  .rito-product-page__section-title {
    margin: 0 0 16px;
    font-family: var(--font-heading--family);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.1;
  }

  .rito-product-page__section-text {
    margin: 0;
    color: #4b392d;
    font-size: 16px;
    line-height: 1.8;
  }

  .rito-product-page__notes-grid,
  .rito-product-page__brew-grid,
  .rito-product-page__related-grid {
    display: grid;
    gap: 16px;
  }

  .rito-product-page__notes-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .rito-product-page__note-card,
  .rito-product-page__brew-card {
    padding: 18px;
    border: 1px solid #e8ded2;
    border-radius: 20px;
    background: #f8f3ec;
  }

  .rito-product-page__brew-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .rito-product-page__brew-card {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #20140e;
    font-weight: 700;
  }

  .rito-product-page__brew-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: #ead8c0;
    color: #2a1b12;
    flex: 0 0 38px;
  }

  .rito-product-page__brew-badge svg {
    width: 22px;
    height: 22px;
  }

  .rito-product-page__related-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .rito-product-page__related-card {
    overflow: hidden;
    border: 1px solid #e8ded2;
    border-radius: 26px;
    background: #ffffff;
    box-shadow: 0 18px 42px rgba(42, 27, 18, 0.06);
  }

  .rito-product-page__related-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .rito-product-page__related-media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 260px;
    padding: 24px;
    background: linear-gradient(180deg, #f7efe5 0%, #efe1d1 100%);
  }

  .rito-product-page__related-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .rito-product-page__related-content {
    padding: 20px;
  }

  .rito-product-page__related-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 22px;
    line-height: 1.15;
  }

  .rito-product-page__related-price {
    margin: 10px 0 0;
    color: #9a6a43;
    font-weight: 800;
  }

  @media screen and (max-width: 1023px) {
    .rito-product-page__hero {
      grid-template-columns: 1fr;
    }

    .rito-product-page__purchase-card {
      position: static;
    }

    .rito-product-page__gallery-card {
      min-height: 480px;
    }

    .rito-product-page__gallery-image-wrap,
    .rito-product-page__gallery-placeholder {
      min-height: 400px;
    }

    .rito-product-page__related-grid,
    .rito-product-page__brew-grid,
    .rito-product-page__notes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 639px) {
    .rito-product-page {
      padding: 48px 18px;
    }

    .rito-product-page__gallery-card {
      min-height: 380px;
      padding: 22px;
    }

    .rito-product-page__gallery-image-wrap,
    .rito-product-page__gallery-placeholder {
      min-height: 336px;
    }

    .rito-product-page__purchase-card,
    .rito-product-page__info-section {
      padding: 24px;
    }

    .rito-product-page__title {
      font-size: 36px;
    }

    .rito-product-page__meta-grid,
    .rito-product-page__related-grid,
    .rito-product-page__brew-grid,
    .rito-product-page__notes-grid {
      grid-template-columns: 1fr;
    }

    .rito-product-page__thumbnails {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Information",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
