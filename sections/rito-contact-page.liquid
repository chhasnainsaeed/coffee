<section class="rito-contact-hero color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="rito-contact-hero__inner">
    <p class="rito-contact-hero__eyebrow">CONTACT US</p>
    <h1 class="rito-contact-hero__title">Let&rsquo;s Talk Coffee</h1>
    <p class="rito-contact-hero__subtitle">
      Have a question about our blends, orders, or coffee rituals? We&rsquo;re here to help.
    </p>
  </div>
</section>

<section class="rito-contact-main color-{{ section.settings.color_scheme }}">
  <div class="rito-contact-main__inner">
    <div class="rito-contact-layout">
      <aside class="rito-contact-info">
        <div class="rito-contact-info__glow" aria-hidden="true"></div>
        <p class="rito-contact-info__eyebrow">RITO DEL CAFF&Egrave; 1937</p>
        <h2 class="rito-contact-info__title">Need help choosing your perfect blend?</h2>
        <p class="rito-contact-info__text">
          Whether you&rsquo;re looking for a bold espresso, a smooth filter coffee, or a curated sampler pack,
          our team is happy to guide you.
        </p>

        <div class="rito-contact-info__cards">
          <div class="rito-contact-info__card">
            <span class="rito-contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="presentation">
                <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5v-9z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <path d="M5 8l7 5 7-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div>
              <p class="rito-contact-info__label">Email us</p>
              <a href="mailto:hello@ritodelcaffe.com" class="rito-contact-info__value">hello@ritodelcaffe.com</a>
            </div>
          </div>

          <div class="rito-contact-info__card">
            <span class="rito-contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="presentation">
                <path d="M6 16v-4a6 6 0 1 1 12 0v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <rect x="4" y="14" width="3.5" height="5.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <rect x="16.5" y="14" width="3.5" height="5.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
              </svg>
            </span>
            <div>
              <p class="rito-contact-info__label">Customer support</p>
              <p class="rito-contact-info__value">Monday &ndash; Friday, 9:00 AM &ndash; 5:00 PM</p>
            </div>
          </div>

          <div class="rito-contact-info__card">
            <span class="rito-contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="presentation">
                <path d="M12 20s6-5.4 6-10a6 6 0 1 0-12 0c0 4.6 6 10 6 10z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <circle cx="12" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
              </svg>
            </span>
            <div>
              <p class="rito-contact-info__label">Location</p>
              <p class="rito-contact-info__value">United States</p>
            </div>
          </div>

          <div class="rito-contact-info__card">
            <span class="rito-contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="presentation">
                <path d="M7 8h7a0 0 0 0 1 0 0v3A4 4 0 0 1 10 15H9a4 4 0 0 1-4-4V8a0 0 0 0 1 0 0z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <path d="M14 9h1.8a2.1 2.1 0 0 1 0 4.2H14" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <path d="M8 18h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
            <div>
              <p class="rito-contact-info__label">Follow us</p>
              <p class="rito-contact-info__value">Instagram &bull; Facebook &bull; TikTok</p>
            </div>
          </div>
        </div>
      </aside>

      <div class="rito-contact-form-panel">
        <h2 class="rito-contact-form-panel__title">Send Us a Message</h2>
        <p class="rito-contact-form-panel__subtitle">
          Fill out the form below and we&rsquo;ll get back to you as soon as possible.
        </p>

        <form class="rito-contact-form" data-contact-form novalidate>
          <div class="rito-contact-form__grid">
            <div class="rito-contact-form__field">
              <label for="RitoContactName-{{ section.id }}">Full Name</label>
              <input id="RitoContactName-{{ section.id }}" name="full_name" type="text" placeholder="Enter your full name">
            </div>

            <div class="rito-contact-form__field">
              <label for="RitoContactEmail-{{ section.id }}">Email Address</label>
              <input id="RitoContactEmail-{{ section.id }}" name="email" type="email" placeholder="Enter your email address">
            </div>

            <div class="rito-contact-form__field">
              <label for="RitoContactPhone-{{ section.id }}">Phone Number</label>
              <input id="RitoContactPhone-{{ section.id }}" name="phone" type="tel" placeholder="Enter your phone number">
            </div>

            <div class="rito-contact-form__field">
              <label for="RitoContactSubject-{{ section.id }}">Subject</label>
              <select id="RitoContactSubject-{{ section.id }}" name="subject">
                <option>General Question</option>
                <option>Order Support</option>
                <option>Product Recommendation</option>
                <option>Wholesale Inquiry</option>
                <option>Shipping &amp; Returns</option>
              </select>
            </div>

            <div class="rito-contact-form__field rito-contact-form__field--full">
              <label for="RitoContactMessage-{{ section.id }}">Message</label>
              <textarea id="RitoContactMessage-{{ section.id }}" name="message" placeholder="Tell us how we can help&hellip;"></textarea>
            </div>
          </div>

          <button type="submit" class="rito-contact-form__submit">Send Message</button>
          <div class="rito-contact-form__success" data-contact-success aria-live="polite" hidden>
            Thank you! Your message has been received.
          </div>
        </form>
      </div>
    </div>

    <div class="rito-contact-support">
      <div class="rito-contact-support__card">
        <h3 class="rito-contact-support__title">Shipping Questions</h3>
        <p class="rito-contact-support__text">Learn about delivery times and order tracking.</p>
        <a href="#" class="rito-contact-support__link">View Shipping Policy</a>
      </div>
      <div class="rito-contact-support__card">
        <h3 class="rito-contact-support__title">Returns &amp; Refunds</h3>
        <p class="rito-contact-support__text">Need help with a return or refund request?</p>
        <a href="#" class="rito-contact-support__link">View Return Policy</a>
      </div>
      <div class="rito-contact-support__card">
        <h3 class="rito-contact-support__title">Product Help</h3>
        <p class="rito-contact-support__text">Not sure which blend to choose?</p>
        <a href="/collections/all" class="rito-contact-support__link">Explore Coffee Guide</a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-contact-form]').forEach(function (form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var success = form.querySelector('[data-contact-success]');
        if (success) {
          success.hidden = false;
        }
        form.reset();
      });
    });
  });
</script>

{% stylesheet %}
  .rito-contact-hero {
    position: relative;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 90px 40px 70px;
    background: linear-gradient(180deg, #fbf7f1 0%, #efe1d1 100%);
    text-align: center;
  }

  .rito-contact-hero__inner,
  .rito-contact-main__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .rito-contact-hero__eyebrow,
  .rito-contact-info__eyebrow {
    margin: 0 0 14px;
    color: #9a6a43;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .rito-contact-hero__title {
    margin: 0;
    color: #20140e;
    font-family: var(--font-heading--family);
    font-size: clamp(42px, 5vw, 72px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .rito-contact-hero__subtitle {
    max-width: 720px;
    margin: 18px auto 0;
    color: #7a6a5c;
    font-size: 18px;
    line-height: 1.7;
  }

  .rito-contact-main {
    background: #f8f3ec;
    padding: 80px 40px 110px;
    color: #20140e;
  }

  .rito-contact-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 40px;
    align-items: start;
  }

  .rito-contact-info,
  .rito-contact-form-panel,
  .rito-contact-support {
    border-radius: 36px;
    box-shadow: 0 28px 80px rgba(42, 27, 18, 0.08);
  }

  .rito-contact-info {
    position: relative;
    overflow: hidden;
    min-height: 640px;
    padding: 44px;
    background: #2a1b12;
    color: #ffffff;
    box-shadow: 0 28px 80px rgba(42, 27, 18, 0.16);
  }

  .rito-contact-info__glow {
    position: absolute;
    top: -120px;
    right: -80px;
    width: 320px;
    height: 320px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(184, 135, 70, 0.22) 0%, rgba(184, 135, 70, 0) 72%);
    pointer-events: none;
  }

  .rito-contact-info > * {
    position: relative;
    z-index: 1;
  }

  .rito-contact-info__title,
  .rito-contact-form-panel__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(30px, 3vw, 42px);
    line-height: 1.08;
    font-weight: 700;
  }

  .rito-contact-info__text,
  .rito-contact-form-panel__subtitle {
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 16px;
    line-height: 1.8;
  }

  .rito-contact-info__cards {
    display: grid;
    gap: 16px;
    margin-top: 28px;
  }

  .rito-contact-info__card {
    display: flex;
    gap: 14px;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.08);
  }

  .rito-contact-info__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    border-radius: 999px;
    background: rgba(184, 135, 70, 0.22);
    color: #b88746;
  }

  .rito-contact-info__icon svg {
    width: 22px;
    height: 22px;
  }

  .rito-contact-info__label {
    margin: 0 0 6px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rito-contact-info__value,
  .rito-contact-info__value:visited {
    color: #ffffff;
    font-size: 15px;
    line-height: 1.7;
    text-decoration: none;
  }

  .rito-contact-form-panel {
    padding: 44px;
    border: 1px solid #e8ded2;
    background: #ffffff;
  }

  .rito-contact-form-panel__subtitle {
    color: #7a6a5c;
  }

  .rito-contact-form {
    margin-top: 26px;
  }

  .rito-contact-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .rito-contact-form__field {
    display: grid;
    gap: 10px;
  }

  .rito-contact-form__field--full {
    grid-column: 1 / -1;
  }

  .rito-contact-form__field label {
    color: #20140e;
    font-size: 14px;
    font-weight: 700;
  }

  .rito-contact-form__field input,
  .rito-contact-form__field select,
  .rito-contact-form__field textarea {
    width: 100%;
    border: 1px solid #e8ded2;
    border-radius: 18px;
    background: #fbf7f1;
    color: #20140e;
    font-size: 15px;
    padding: 0 18px;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .rito-contact-form__field input,
  .rito-contact-form__field select {
    height: 54px;
  }

  .rito-contact-form__field textarea {
    min-height: 150px;
    padding-top: 16px;
    padding-bottom: 16px;
    resize: vertical;
  }

  .rito-contact-form__field input:focus,
  .rito-contact-form__field select:focus,
  .rito-contact-form__field textarea:focus {
    border-color: #b88746;
    box-shadow: 0 0 0 4px rgba(184, 135, 70, 0.12);
  }

  .rito-contact-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 22px;
    height: 56px;
    padding: 0 30px;
    border: 0;
    border-radius: 999px;
    background: #2a1b12;
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .rito-contact-form__submit:hover,
  .rito-contact-form__submit:focus-visible {
    background: #b88746;
  }

  .rito-contact-form__success {
    margin-top: 18px;
    padding: 14px 16px;
    border: 1px solid #e8ded2;
    border-radius: 18px;
    background: #f8f3ec;
    color: #2a1b12;
    font-size: 15px;
    line-height: 1.6;
  }

  .rito-contact-support {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 70px;
    padding: 34px;
    border: 1px solid #e8ded2;
    background: #ffffff;
    box-shadow: 0 22px 60px rgba(42, 27, 18, 0.06);
  }

  .rito-contact-support__card {
    padding: 24px;
    border-radius: 24px;
    background: #f8f3ec;
  }

  .rito-contact-support__title {
    margin: 0;
    color: #20140e;
    font-family: var(--font-heading--family);
    font-size: 22px;
    line-height: 1.2;
  }

  .rito-contact-support__text {
    margin: 12px 0 0;
    color: #7a6a5c;
    font-size: 15px;
    line-height: 1.7;
  }

  .rito-contact-support__link {
    display: inline-flex;
    margin-top: 16px;
    color: #9a6a43;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .rito-contact-support__link:hover,
  .rito-contact-support__link:focus-visible {
    color: #b88746;
  }

  @media screen and (max-width: 1023px) {
    .rito-contact-layout {
      grid-template-columns: 1fr;
    }

    .rito-contact-info {
      min-height: auto;
    }
  }

  @media screen and (max-width: 639px) {
    .rito-contact-hero {
      padding: 70px 18px 50px;
    }

    .rito-contact-main {
      padding: 48px 18px 80px;
    }

    .rito-contact-hero__title {
      font-size: 38px;
    }

    .rito-contact-info {
      padding: 28px;
    }

    .rito-contact-form-panel {
      padding: 24px;
    }

    .rito-contact-form__grid,
    .rito-contact-support {
      grid-template-columns: 1fr;
    }

    .rito-contact-form__submit {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rito Contact Page",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
