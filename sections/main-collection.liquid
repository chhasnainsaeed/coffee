{% liquid
  assign collection_title = collection.title
  if collection.handle == 'all' or collection_title == blank
    assign collection_title = 'All Coffee Blends'
  endif

  assign collection_subtitle = collection.description | strip_html | strip
  if collection_subtitle == blank
    assign collection_subtitle = 'Explore premium Italian-inspired coffee blends crafted for espresso, cappuccino, filter coffee, and everyday rituals.'
  endif

  assign featured_products = collection.products
%}

<section class="rito-collection-hero color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="rito-collection-hero__inner">
    <p class="rito-collection-hero__eyebrow">SHOP COFFEE</p>
    <h1 class="rito-collection-hero__title">{{ collection_title }}</h1>
    <p class="rito-collection-hero__subtitle">{{ collection_subtitle }}</p>
  </div>
</section>

<section class="rito-collection-main color-{{ section.settings.color_scheme }}">
  <div class="rito-collection-main__inner">
    <div class="rito-collection-toolbar">
      <p class="rito-collection-toolbar__count" data-collection-count>{{ featured_products.size }} products</p>

      <div class="rito-collection-toolbar__filters" role="tablist" aria-label="Filter coffee categories">
        <button type="button" class="rito-filter-pill is-active" data-filter="all" aria-pressed="true">All</button>
        <button type="button" class="rito-filter-pill" data-filter="whole-bean" aria-pressed="false">Whole Bean</button>
        <button type="button" class="rito-filter-pill" data-filter="espresso" aria-pressed="false">Espresso</button>
        <button type="button" class="rito-filter-pill" data-filter="filter-coffee" aria-pressed="false">Filter Coffee</button>
        <button type="button" class="rito-filter-pill" data-filter="decaf" aria-pressed="false">Decaf</button>
        <button type="button" class="rito-filter-pill" data-filter="ground-coffee" aria-pressed="false">Ground Coffee</button>
        <button type="button" class="rito-filter-pill" data-filter="sampler" aria-pressed="false">Sampler</button>
      </div>

      <label class="rito-collection-toolbar__sort-wrap">
        <span class="visually-hidden">Sort products</span>
        <select class="rito-collection-toolbar__sort" data-sort>
          <option value="featured">Featured</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="name-asc">Name: A to Z</option>
        </select>
      </label>
    </div>

    <div class="rito-collection-grid" data-collection-grid>
      {% for product in featured_products %}
        {% liquid
          assign subtitle = product.metafields.custom.subtitle.value | default: product.metafields.custom.subtitle
          assign roast_level = product.metafields.custom.roast_level.value | default: product.metafields.custom.roast_level
          assign coffee_type = product.metafields.custom.coffee_type.value | default: product.metafields.custom.coffee_type
          assign net_weight = product.metafields.custom.net_weight.value | default: product.metafields.custom.net_weight
          assign category = product.metafields.custom.category.value | default: product.metafields.custom.category
          assign badge_text = 'Italian Roast'

          case product.handle
            when 'il-cappuccino'
              assign subtitle_fallback = 'Rich & Creamy Italian Blend'
              assign category_fallback = 'Whole Bean'
              assign roast_fallback = 'Medium Roast'
              assign type_fallback = 'Premium Whole Bean Coffee'
              assign weight_fallback = '250g / 8.8oz'
            when 'il-decaf'
              assign subtitle_fallback = 'Smooth Italian Decaffeinated Blend'
              assign category_fallback = 'Decaf'
              assign roast_fallback = 'Medium Roast'
              assign type_fallback = 'Premium Whole Bean Coffee'
              assign weight_fallback = '250g / 8.8oz'
            when 'l-espresso', 'lespresso', 'the-espresso', 'espresso'
              assign subtitle_fallback = 'Bold & Intense Italian Blend'
              assign category_fallback = 'Espresso'
              assign roast_fallback = 'Dark Roast'
              assign type_fallback = 'Premium Whole Bean Coffee'
              assign weight_fallback = '250g / 8.8oz'
            when 'espresso-quattro', 'the-espresso-4'
              assign subtitle_fallback = 'Strong Italian Espresso Blend'
              assign category_fallback = 'Espresso'
              assign roast_fallback = 'Extra Dark Roast'
              assign type_fallback = 'Premium Whole Bean Coffee'
              assign weight_fallback = '250g / 8.8oz'
            when 'il-filtro', 'the-filter'
              assign subtitle_fallback = 'Smooth Filter Coffee Blend'
              assign category_fallback = 'Filter Coffee'
              assign roast_fallback = 'Medium Roast'
              assign type_fallback = 'Premium Whole Bean Coffee'
              assign weight_fallback = '250g / 8.8oz'
            when 'il-maestro', 'the-maestro'
              assign subtitle_fallback = 'Signature Italian House Blend'
              assign category_fallback = 'Whole Bean'
              assign roast_fallback = 'Medium-Dark Roast'
              assign type_fallback = 'Premium Whole Bean Coffee'
              assign weight_fallback = '250g / 8.8oz'
            when 'single-filter', 'the-single-filter'
              assign subtitle_fallback = 'Clean & Balanced Single Serve Filter Coffee'
              assign category_fallback = 'Filter Coffee'
              assign roast_fallback = 'Medium Roast'
              assign type_fallback = 'Premium Filter Coffee'
              assign weight_fallback = '250g / 8.8oz'
            when 'il-sultano', 'the-sultan'
              assign subtitle_fallback = 'Rich Turkish Style Coffee'
              assign category_fallback = 'Ground Coffee'
              assign roast_fallback = 'Dark Roast'
              assign type_fallback = 'Premium Ground Coffee'
              assign weight_fallback = '100g / 3.5oz'
            when 'italian-coffee-sampler', 'sampler-product'
              assign subtitle_fallback = 'A Curated Selection of Premium Italian Blends'
              assign category_fallback = 'Sampler'
              assign roast_fallback = 'Mixed Roast Selection'
              assign type_fallback = 'Premium Coffee Collection'
              assign weight_fallback = 'Sampler Pack'
            else
              assign subtitle_fallback = product.description | strip_html | truncatewords: 10
              assign category_fallback = 'Whole Bean'
              assign roast_fallback = 'Medium Roast'
              assign type_fallback = 'Premium Whole Bean Coffee'
              assign weight_fallback = '250g / 8.8oz'
          endcase

          if subtitle == blank
            assign subtitle = subtitle_fallback
          endif
          if category == blank
            assign category = category_fallback
          endif
          if roast_level == blank
            assign roast_level = roast_fallback
          endif
          if coffee_type == blank
            assign coffee_type = type_fallback
          endif
          if net_weight == blank
            assign net_weight = weight_fallback
          endif

          assign category_slug = category | handleize
          assign product_image = product.featured_media.preview_image
        %}

        <article
          class="rito-collection-card"
          data-product-card
          data-category="{{ category_slug }}"
          data-title="{{ product.title | escape }}"
          data-price="{{ product.price }}"
          data-featured-order="{{ forloop.index0 }}"
        >
          <a href="{{ product.url }}" class="rito-collection-card__media-link" aria-label="View {{ product.title }}">
            <div class="rito-collection-card__media">
              <span class="rito-collection-card__badge">{{ category | default: badge_text }}</span>
              {% if product_image != blank %}
                {{
                  product_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'rito-collection-card__image',
                    widths: '360, 540, 720, 900, 1200',
                    sizes: '(min-width: 1200px) 22vw, (min-width: 900px) 31vw, (min-width: 640px) 46vw, 100vw',
                    alt: product_image.alt | default: product.title,
                    loading: 'lazy'
                }}
              {% else %}
                <div class="rito-collection-card__placeholder" aria-hidden="true">
                  <svg viewBox="0 0 320 320" role="presentation">
                    <defs>
                      <linearGradient id="rito-card-placeholder-bg-{{ forloop.index }}" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#f6ede2"/>
                        <stop offset="100%" stop-color="#ead8c0"/>
                      </linearGradient>
                    </defs>
                    <rect width="320" height="320" rx="28" fill="url(#rito-card-placeholder-bg-{{ forloop.index }})"/>
                    <ellipse cx="160" cy="248" rx="86" ry="24" fill="#d8bea0"/>
                    <path d="M109 91c0-14 10-24 24-24h54c14 0 24 10 24 24v133c0 16-13 29-29 29h-44c-16 0-29-13-29-29V91z" fill="#8b5e3c"/>
                    <path d="M123 99h74v115c0 14-11 25-25 25h-24c-14 0-25-11-25-25V99z" fill="#bb8d5c"/>
                    <rect x="136" y="136" width="48" height="64" rx="8" fill="#f7f0e5"/>
                    <circle cx="160" cy="113" r="8" fill="#c69b57"/>
                    <path d="M136 70h48l10 24h-68l10-24z" fill="#6f482d"/>
                  </svg>
                </div>
              {% endif %}
            </div>
          </a>

          <div class="rito-collection-card__content">
            <p class="rito-collection-card__category">{{ category }}</p>
            <h2 class="rito-collection-card__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h2>
            <p class="rito-collection-card__subtitle">{{ subtitle }}</p>
            <div class="rito-collection-card__meta">
              <span>{{ roast_level }}</span>
              <span>{{ coffee_type }}</span>
              <span>{{ net_weight }}</span>
            </div>
            <p class="rito-collection-card__price">{{ product.price | money }}</p>

            <div class="rito-collection-card__actions">
              <a href="{{ product.url }}" class="rito-collection-card__button rito-collection-card__button--primary">View Product</a>
              {% form 'product', product, class: 'rito-collection-card__form' %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="rito-collection-card__button rito-collection-card__button--secondary">Add to Cart</button>
              {% endform %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="rito-collection-empty" data-empty-state hidden>
      <h2 class="rito-collection-empty__title">No blends found</h2>
      <p class="rito-collection-empty__text">Try a different category or view all coffee.</p>
      <button type="button" class="rito-collection-empty__action" data-reset-filter>View All Coffee</button>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.rito-collection-main').forEach(function (section) {
      var cards = Array.prototype.slice.call(section.querySelectorAll('[data-product-card]'));
      var filterButtons = Array.prototype.slice.call(section.querySelectorAll('[data-filter]'));
      var sortSelect = section.querySelector('[data-sort]');
      var countLabel = section.querySelector('[data-collection-count]');
      var grid = section.querySelector('[data-collection-grid]');
      var emptyState = section.querySelector('[data-empty-state]');
      var resetFilter = section.querySelector('[data-reset-filter]');

      if (!cards.length || !grid) return;

      var currentFilter = 'all';
      var currentSort = 'featured';

      function getVisibleCards() {
        return cards.filter(function (card) {
          if (currentFilter === 'all') return true;
          return card.getAttribute('data-category') === currentFilter;
        });
      }

      function sortCards(list) {
        return list.slice().sort(function (a, b) {
          if (currentSort === 'price-asc') {
            return parseInt(a.getAttribute('data-price'), 10) - parseInt(b.getAttribute('data-price'), 10);
          }
          if (currentSort === 'price-desc') {
            return parseInt(b.getAttribute('data-price'), 10) - parseInt(a.getAttribute('data-price'), 10);
          }
          if (currentSort === 'name-asc') {
            return a.getAttribute('data-title').localeCompare(b.getAttribute('data-title'));
          }
          return parseInt(a.getAttribute('data-featured-order'), 10) - parseInt(b.getAttribute('data-featured-order'), 10);
        });
      }

      function render() {
        var visibleCards = sortCards(getVisibleCards());

        cards.forEach(function (card) {
          card.hidden = true;
        });

        visibleCards.forEach(function (card) {
          card.hidden = false;
          grid.appendChild(card);
        });

        if (countLabel) {
          countLabel.textContent = visibleCards.length + (visibleCards.length === 1 ? ' product' : ' products');
        }

        if (emptyState) {
          emptyState.hidden = visibleCards.length !== 0;
        }
      }

      filterButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          currentFilter = button.getAttribute('data-filter');
          filterButtons.forEach(function (item) {
            item.classList.toggle('is-active', item === button);
            item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
          });
          render();
        });
      });

      if (sortSelect) {
        sortSelect.addEventListener('change', function () {
          currentSort = sortSelect.value;
          render();
        });
      }

      if (resetFilter) {
        resetFilter.addEventListener('click', function () {
          currentFilter = 'all';
          if (sortSelect) currentSort = sortSelect.value;
          filterButtons.forEach(function (item) {
            var active = item.getAttribute('data-filter') === 'all';
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          render();
        });
      }

      render();
    });
  });
</script>

{% stylesheet %}
  .rito-collection-hero {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 90px 40px 70px;
    background: linear-gradient(180deg, #fbf7f1 0%, #efe1d1 100%);
    text-align: center;
  }

  .rito-collection-hero__inner,
  .rito-collection-main__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .rito-collection-hero__eyebrow {
    margin: 0 0 14px;
    color: #9a6a43;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .rito-collection-hero__title {
    margin: 0;
    color: #20140e;
    font-family: var(--font-heading--family);
    font-size: clamp(42px, 5vw, 72px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .rito-collection-hero__subtitle {
    max-width: 860px;
    margin: 18px auto 0;
    color: #7a6a5c;
    font-size: 18px;
    line-height: 1.8;
  }

  .rito-collection-main {
    width: 100%;
    padding: 64px 40px 100px;
    background: #f8f3ec;
    color: #20140e;
  }

  .rito-collection-toolbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    margin-bottom: 34px;
  }

  .rito-collection-toolbar__count {
    margin: 0;
    color: #7a6a5c;
    font-size: 15px;
    font-weight: 700;
  }

  .rito-collection-toolbar__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .rito-filter-pill,
  .rito-collection-toolbar__sort {
    height: 44px;
    border: 1px solid #e8ded2;
    border-radius: 999px;
    background: #ffffff;
    color: #2a1b12;
    font-size: 14px;
    font-weight: 700;
  }

  .rito-filter-pill {
    padding: 10px 16px;
    cursor: pointer;
    transition: background-color 0.28s ease, color 0.28s ease, border-color 0.28s ease, transform 0.28s ease;
  }

  .rito-filter-pill:hover,
  .rito-filter-pill:focus-visible,
  .rito-collection-toolbar__sort:hover,
  .rito-collection-toolbar__sort:focus-visible {
    border-color: #b88746;
  }

  .rito-filter-pill.is-active {
    border-color: #2a1b12;
    background: #2a1b12;
    color: #ffffff;
  }

  .rito-collection-toolbar__sort {
    min-width: 192px;
    padding: 0 16px;
    cursor: pointer;
  }

  .rito-collection-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    width: 100%;
  }

  .rito-collection-card {
    display: flex;
    flex-direction: column;
    padding: 20px;
    border: 1px solid #e8ded2;
    border-radius: 28px;
    background: #ffffff;
    box-shadow: 0 20px 55px rgba(42, 27, 18, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .rito-collection-card:hover {
    transform: translateY(-6px);
    border-color: rgba(184, 135, 70, 0.45);
    box-shadow: 0 28px 75px rgba(42, 27, 18, 0.14);
  }

  .rito-collection-card__media-link {
    display: block;
    text-decoration: none;
  }

  .rito-collection-card__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    height: 300px;
    margin-bottom: 22px;
    border-radius: 22px;
    background: linear-gradient(180deg, #f7efe5 0%, #efe1d1 100%);
  }

  .rito-collection-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    padding: 7px 13px;
    border: 1px solid rgba(184, 135, 70, 0.28);
    border-radius: 999px;
    background: rgba(255, 246, 232, 0.95);
    color: #9a6a43;
    font-size: 12px;
    font-weight: 800;
  }

  .rito-collection-card__image,
  .rito-collection-card__placeholder {
    width: 100%;
    height: 100%;
  }

  .rito-collection-card__image {
    object-fit: contain;
    transform: scale(1.08);
    transition: transform 0.35s ease;
  }

  .rito-collection-card:hover .rito-collection-card__image {
    transform: scale(1.13);
  }

  .rito-collection-card__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .rito-collection-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0 4px;
  }

  .rito-collection-card__category {
    margin: 0 0 10px;
    color: #9a6a43;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .rito-collection-card__title {
    margin: 0 0 8px;
    color: #20140e;
    font-family: var(--font-heading--family);
    font-size: 20px;
    line-height: 1.25;
    font-weight: 800;
  }

  .rito-collection-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .rito-collection-card__subtitle {
    margin: 0 0 16px;
    color: #7a6a5c;
    font-size: 14px;
    line-height: 1.55;
  }

  .rito-collection-card__meta {
    display: grid;
    gap: 6px;
    margin-bottom: 16px;
    color: #7a6a5c;
    font-size: 13px;
    line-height: 1.5;
  }

  .rito-collection-card__price {
    margin: 0 0 18px;
    color: #9a6a43;
    font-size: 18px;
    font-weight: 800;
  }

  .rito-collection-card__actions {
    display: grid;
    gap: 10px;
    margin-top: auto;
  }

  .rito-collection-card__form {
    margin: 0;
  }

  .rito-collection-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 46px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition: background-color 0.28s ease, color 0.28s ease, border-color 0.28s ease;
  }

  .rito-collection-card__button--primary {
    background: #2a1b12;
    color: #ffffff;
  }

  .rito-collection-card__button--primary:hover,
  .rito-collection-card__button--primary:focus-visible {
    background: #b88746;
  }

  .rito-collection-card__button--secondary {
    border: 1px solid #2a1b12;
    background: transparent;
    color: #2a1b12;
    cursor: pointer;
  }

  .rito-collection-card__button--secondary:hover,
  .rito-collection-card__button--secondary:focus-visible {
    background: #2a1b12;
    color: #ffffff;
  }

  .rito-collection-empty {
    padding: 42px 24px;
    border: 1px solid #e8ded2;
    border-radius: 28px;
    background: #fffdf9;
    text-align: center;
    box-shadow: 0 18px 40px rgba(42, 27, 18, 0.05);
  }

  .rito-collection-empty__title {
    margin: 0;
    color: #20140e;
    font-family: var(--font-heading--family);
    font-size: 28px;
  }

  .rito-collection-empty__text {
    margin: 12px 0 0;
    color: #7a6a5c;
    font-size: 16px;
  }

  .rito-collection-empty__action {
    margin-top: 20px;
    padding: 0 20px;
    height: 46px;
    border: 0;
    border-radius: 999px;
    background: #2a1b12;
    color: #ffffff;
    font-weight: 800;
    cursor: pointer;
  }

  @media screen and (max-width: 1199px) {
    .rito-collection-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 899px) {
    .rito-collection-toolbar {
      grid-template-columns: 1fr;
      align-items: flex-start;
    }

    .rito-collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 639px) {
    .rito-collection-hero {
      padding: 70px 18px 50px;
    }

    .rito-collection-main {
      padding: 44px 18px 72px;
    }

    .rito-collection-hero__title {
      font-size: 38px;
    }

    .rito-collection-grid {
      grid-template-columns: 1fr;
    }

    .rito-collection-card__media {
      height: 280px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Main Collection",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": []
}
{% endschema %}
