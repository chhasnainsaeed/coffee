{% liquid
  assign max_items = section.settings.max_products
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    rito-product-showcase
    rito-product-showcase--{{ section.settings.layout_type }}
    spacing-style
    gap-style
  "
  data-layout-type="{{ section.settings.layout_type }}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% paginate section.settings.collection.products by max_items %}
        {% for product in section.settings.collection.products limit: max_items %}
          <div
            class="resource-list__item"
          >
            {% # theme-check-disable UniqueStaticBlockId %}
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
            {% # theme-check-enable UniqueStaticBlockId %}
          </div>

          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
        >
          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'resource-list-grid'
  %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  .rito-product-showcase {
    --rito-showcase-ink: #2f2a27;
    --rito-showcase-muted: rgb(47 42 39 / 0.58);
    --rito-showcase-accent: #b68a62;
    --rito-showcase-price: #9a6d48;
    --rito-showcase-paper: #ffffff;
    --rito-showcase-panel: #f6f3ef;
    --rito-showcase-line: rgb(47 42 39 / 0.1);
    --rito-showcase-sale: #ef3651;

    position: relative;
    isolation: isolate;
    color: var(--rito-showcase-ink);
    background: var(--rito-showcase-paper);
    padding-inline: clamp(18px, 3.5vw, 52px);
  }

  .rito-product-showcase::before {
    content: none;
  }

  .rito-product-showcase .section-resource-list__header {
    max-width: 1320px;
    width: 100%;
    margin: 0 auto;
    padding-block-end: clamp(28px, 3.6vw, 46px);
    text-align: center;
  }

  .rito-product-showcase .section-resource-list__header .group-block-content {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .rito-product-showcase .section-resource-list__header h3 {
    margin: 0;
    max-width: none;
    color: var(--rito-showcase-ink);
    font-family: var(--font-subheading--family);
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rito-product-showcase .section-resource-list__header h3::before {
    content: 'Best Seller';
    display: block;
    margin-block-end: 8px;
    color: var(--rito-showcase-accent);
    font-family: var(--font-subheading--family);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .rito-product-showcase .section-resource-list__header h3::after {
    content: 'Best seller products this week';
    display: block;
    margin-block-start: 10px;
    color: var(--rito-showcase-muted);
    font-family: var(--font-paragraph--family);
    font-size: 0.88rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: none;
  }

  .rito-product-showcase .section-resource-list__header .button,
  .rito-product-showcase .section-resource-list__header .button-secondary,
  .rito-product-showcase .section-resource-list__header a {
    color: var(--rito-showcase-ink);
  }

  .rito-product-showcase .section-resource-list__header a {
    min-height: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--rito-showcase-accent);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .rito-product-showcase .resource-list {
    max-width: 1320px;
    margin: 0 auto;
  }

  .rito-product-showcase[data-layout-type='modern'] .resource-list--grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(22px, 2.8vw, 42px) clamp(18px, 2.4vw, 34px);
    align-items: stretch;
  }

  .rito-product-showcase[data-layout-type='modern'] .resource-list__item {
    position: relative;
    min-width: 0;
    min-height: 100%;
  }

  .rito-product-showcase[data-layout-type='modern'] .product-card {
    height: 100%;
    transition: translate 180ms ease;
  }

  .rito-product-showcase[data-layout-type='modern'] .product-card:hover {
    translate: 0 -3px;
  }

  .rito-product-showcase[data-layout-type='modern'] .product-card__content {
    height: 100%;
    gap: 10px;
    padding: 0;
    background: transparent;
    align-items: center;
    text-align: center;
  }

  .rito-product-showcase[data-layout-type='modern'] .card-gallery {
    width: 100%;
    border-radius: 0;
    background: var(--rito-showcase-panel);
    box-shadow: none;
  }

  .rito-product-showcase[data-layout-type='modern'] .card-gallery img,
  .rito-product-showcase[data-layout-type='modern'] .card-gallery .product-card__image {
    scale: 0.86;
    object-fit: contain;
    transition: scale 220ms ease;
  }

  .rito-product-showcase[data-layout-type='modern'] .product-card:hover .card-gallery img,
  .rito-product-showcase[data-layout-type='modern'] .product-card:hover .card-gallery .product-card__image {
    scale: 0.9;
  }

  .rito-product-showcase[data-layout-type='modern'] product-title,
  .rito-product-showcase[data-layout-type='modern'] .product-title,
  .rito-product-showcase[data-layout-type='modern'] .product-card h3,
  .rito-product-showcase[data-layout-type='modern'] .product-card h4 {
    color: var(--rito-showcase-ink);
    font-family: var(--font-subheading--family);
    font-size: 0.88rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .rito-product-showcase[data-layout-type='modern'] product-price,
  .rito-product-showcase[data-layout-type='modern'] .price,
  .rito-product-showcase[data-layout-type='modern'] .h6 {
    color: var(--rito-showcase-price);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .rito-product-showcase[data-layout-type='modern'] .product-badges--top-right {
    top: 0;
    right: 0;
  }

  .rito-product-showcase[data-layout-type='modern'] .product-badges__badge--rectangle {
    min-width: 54px;
    padding: 7px 8px;
    border-radius: 0;
    background: var(--rito-showcase-sale);
    color: #fff;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rito-product-showcase[data-layout-type='modern'] .quick-add__button {
    border-radius: 0;
    background: var(--rito-showcase-ink);
    color: var(--rito-showcase-paper);
  }

  @media screen and (max-width: 749px) {
    .rito-product-showcase {
      padding-inline: 16px;
    }

    .rito-product-showcase .section-resource-list__header .group-block-content {
      align-items: center;
      gap: 10px;
    }

    .rito-product-showcase .section-resource-list__header h3 {
      font-size: clamp(1.35rem, 6vw, 1.75rem);
    }

    .rito-product-showcase[data-layout-type='modern'] .resource-list--grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 14px;
    }

    .rito-product-showcase[data-layout-type='modern'] .product-card__content {
      padding: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_list",
  "class": "ui-test-product-list",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "modern",
          "label": "Modern"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type != 'editorial' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type != 'carousel' and section.settings.layout_type != 'editorial' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "60cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'modern' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
