{% liquid
  assign max_items = section.settings.max_products
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    rito-product-showcase
    rito-product-showcase--premium
    spacing-style
    gap-style
  "
  data-layout-type="premium"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
    --rito-modern-card-padding: {{ section.settings.modern_card_padding }}px;
    --rito-modern-card-radius: {{ section.settings.modern_card_radius }}px;
    --rito-modern-image-radius: {{ section.settings.modern_image_radius }}px;
    --rito-modern-border-opacity: {{ section.settings.modern_border_opacity | times: 0.01 }};
    --rito-modern-shadow-opacity: {{ section.settings.modern_shadow_opacity | times: 0.01 }};
    --rito-modern-hover-lift: {{ section.settings.modern_hover_lift }}px;
    --rito-modern-text-align: {{ section.settings.modern_text_alignment }};
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
    {% if section.settings.modern_subtitle != blank %}
      <p class="rito-product-showcase__subtitle">{{ section.settings.modern_subtitle }}</p>
    {% endif %}
  </div>

  <div class="rito-product-showcase__container">
    <div class="rito-product-showcase__grid" data-testid="resource-list-grid">
      {% if section.settings.collection != blank and shop.products_count != 0 %}
        {% paginate section.settings.collection.products by max_items %}
          {% for product in section.settings.collection.products limit: max_items %}
            {% liquid
              assign product_url = product.selected_or_first_available_variant.url
              assign product_image = product.featured_media.preview_image
              assign product_alt = product_image.alt | default: product.title
            %}
            <article class="rito-product-card">
              <a href="{{ product_url }}" class="rito-product-card__image-link" aria-label="{{ product.title | escape }}">
                <div class="rito-product-card__image-wrap">
                  {% if section.settings.modern_badge_text != blank %}
                    <span class="rito-product-card__badge">{{ section.settings.modern_badge_text }}</span>
                  {% endif %}
                  {% if product_image != blank %}
                    {{
                      product_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'rito-product-card__image',
                        widths: '320, 480, 640, 900',
                        sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 50vw, 100vw',
                        alt: product_alt,
                        loading: 'lazy'
                    }}
                  {% else %}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'rito-product-card__image rito-product-card__image--placeholder' }}
                  {% endif %}
                </div>
              </a>
              <div class="rito-product-card__info">
                {% if section.settings.modern_category_label != blank %}
                  <p class="rito-product-card__category">{{ section.settings.modern_category_label }}</p>
                {% endif %}
                <h3 class="rito-product-card__title">
                  <a href="{{ product_url }}">{{ product.title }}</a>
                </h3>
                <p class="rito-product-card__price">
                  {{ product.price | money }}
                </p>
                <a href="{{ product_url }}" class="rito-product-card__button">
                  <span class="rito-product-card__button-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M3 4h2.2c.4 0 .8.3.9.7l.5 2.3h11.8c.7 0 1.1.6 1 1.2l-1.1 5.4c-.1.5-.5.8-1 .8H9.1c-.5 0-.9-.3-1-.8L6.3 5.8H3V4zm6.6 16.2a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6zm7 0a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z" fill="currentColor"/>
                    </svg>
                  </span>
                  <span>{{ section.settings.modern_cta_label | default: 'Add to cart' }}</span>
                </a>
              </div>
            </article>
          {% endfor %}
        {% endpaginate %}
      {% else %}
        {% for i in (1..max_items) %}
          <article class="rito-product-card">
            <div class="rito-product-card__image-wrap">
              {% if section.settings.modern_badge_text != blank %}
                <span class="rito-product-card__badge">{{ section.settings.modern_badge_text }}</span>
              {% endif %}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'rito-product-card__image rito-product-card__image--placeholder' }}
            </div>
            <div class="rito-product-card__info">
              {% if section.settings.modern_category_label != blank %}
                <p class="rito-product-card__category">{{ section.settings.modern_category_label }}</p>
              {% endif %}
              <h3 class="rito-product-card__title">{{ 'placeholders.product_title' | t }}</h3>
              <p class="rito-product-card__price">{{ 1900 | money }}</p>
              <span class="rito-product-card__button">
                <span class="rito-product-card__button-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M3 4h2.2c.4 0 .8.3.9.7l.5 2.3h11.8c.7 0 1.1.6 1 1.2l-1.1 5.4c-.1.5-.5.8-1 .8H9.1c-.5 0-.9-.3-1-.8L6.3 5.8H3V4zm6.6 16.2a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6zm7 0a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6z" fill="currentColor"/>
                  </svg>
                </span>
                <span>{{ section.settings.modern_cta_label | default: 'Add to cart' }}</span>
              </span>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <div class="section-resource-list__content" style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};">
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  .rito-product-showcase {
    background: #f8f3ec;
    padding:
      80px
      clamp(20px, 3.8vw, 52px);
  }

  .rito-product-showcase::before {
    content: none;
  }

  .rito-product-showcase__container,
  .rito-product-showcase .section-resource-list__header {
    width: 100%;
    max-width: 1680px;
    margin: 0 auto;
  }

  .rito-product-showcase .section-resource-list__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .rito-product-showcase .section-resource-list__header .group-block-content {
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .rito-product-showcase .section-resource-list__header h1,
  .rito-product-showcase .section-resource-list__header h2,
  .rito-product-showcase .section-resource-list__header h3,
  .rito-product-showcase .section-resource-list__header h4 {
    margin: 0;
    color: #2a1b12;
    font-family: var(--font-heading--family);
    font-size: 48px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .rito-product-showcase__subtitle {
    max-width: 620px;
    margin: 0 auto;
    color: #7a6a5c;
    font-size: 18px;
    line-height: 1.65;
  }

  .rito-product-showcase__grid {
    display: grid;
    width: 100%;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .rito-product-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    max-width: none;
    min-height: auto;
    padding: 18px;
    background: #ffffff;
    border: 1px solid #e8ded2;
    border-radius: 24px;
    box-shadow: 0 18px 50px rgba(42, 27, 18, 0.08);
    transition: all 0.3s ease;
  }

  .rito-product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 26px 60px rgba(42, 27, 18, 0.14);
  }

  .rito-product-card__image-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .rito-product-card__image-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: auto;
    margin-bottom: 22px;
    overflow: hidden;
    border-radius: 20px;
    background: linear-gradient(180deg, #f7efe5 0%, #efe1d1 100%);
  }

  .rito-product-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 1;
    padding: 7px 13px;
    border-radius: 999px;
    background: rgba(255, 244, 229, 0.92);
    color: #9a6a43;
    border: 1px solid rgba(184, 135, 70, 0.22);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .rito-product-card__image {
    width: 112%;
    height: 112%;
    max-width: none;
    max-height: none;
    object-fit: contain;
    transform: scale(1);
    transition: transform 0.3s ease;
  }

  .rito-product-card:hover .rito-product-card__image {
    transform: scale(1.04);
  }

  .rito-product-card__image--placeholder {
    width: 100%;
    height: 100%;
  }

  .rito-product-card__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px 6px 4px;
    text-align: left;
  }

  .rito-product-card__category {
    margin: 0 0 10px;
    color: #9a6a43;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .rito-product-card__title {
    margin: 0 0 8px;
    color: #20140e;
    font-family: var(--font-heading--family);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
  }

  .rito-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .rito-product-card__price {
    margin: 0 0 22px;
    color: #9a6a43;
    font-size: 18px;
    font-weight: 700;
  }

  .rito-product-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 48px;
    margin-top: 22px;
    padding: 12px 18px;
    border: none;
    border-radius: 999px;
    background: #2a1b12;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .rito-product-card__button-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  .rito-product-card__button-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .rito-product-card__button:hover,
  .rito-product-card__button:focus-visible {
    background: #b88746;
    color: #ffffff;
    transform: translateY(-1px);
  }

  @media screen and (min-width: 750px) {
    .rito-product-showcase__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1100px) {
    .rito-product-showcase__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .rito-product-showcase {
      padding: 56px 16px;
    }

    .rito-product-showcase .section-resource-list__header h1,
    .rito-product-showcase .section-resource-list__header h2,
    .rito-product-showcase .section-resource-list__header h3,
    .rito-product-showcase .section-resource-list__header h4 {
      font-size: 34px;
    }

    .rito-product-card {
      padding: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_list",
  "class": "ui-test-product-list",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "modern",
          "label": "Modern"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type != 'editorial' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type != 'carousel' and section.settings.layout_type != 'editorial' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "60cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'modern' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "header",
      "content": "Modern grid",
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "textarea",
      "id": "modern_subtitle",
      "label": "Subtitle",
      "default": "Explore our signature Italian coffee blends, crafted for rich aroma and smooth taste.",
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "text",
      "id": "modern_category_label",
      "label": "Category label",
      "default": "Premium Whole Bean Coffee",
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "text",
      "id": "modern_badge_text",
      "label": "Badge text",
      "default": "1937 Blend",
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "text",
      "id": "modern_cta_label",
      "label": "Button label",
      "default": "Add to cart",
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "range",
      "id": "modern_card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "range",
      "id": "modern_card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "range",
      "id": "modern_image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18,
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "range",
      "id": "modern_border_opacity",
      "label": "Card border opacity",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "range",
      "id": "modern_shadow_opacity",
      "label": "Card shadow opacity",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 6,
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "range",
      "id": "modern_hover_lift",
      "label": "Hover lift",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 3,
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "text_alignment",
      "id": "modern_text_alignment",
      "label": "Text alignment",
      "default": "left",
      "visible_if": "{{ section.settings.layout_type == 'modern' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.products_grid",
      "category": "t:categories.products",
      "settings": {
        "collection": "",
        "max_products": 8,
        "layout_type": "grid",
        "modern_subtitle": "Explore our signature Italian coffee blends, crafted for rich aroma and smooth taste.",
        "modern_category_label": "Premium Whole Bean Coffee",
        "modern_badge_text": "1937 Blend",
        "modern_cta_label": "Add to cart",
        "carousel_on_mobile": false,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 8,
        "rows_gap": 24,
        "modern_card_padding": 16,
        "modern_card_radius": 24,
        "modern_image_radius": 18,
        "modern_border_opacity": 8,
        "modern_shadow_opacity": 6,
        "modern_hover_lift": 3,
        "modern_text_alignment": "left",
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "gap": 28,
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
